# Pacific Business Park — cPanel hardening
#
# This site is on the same shared hosting account as axiel.co.za, which sends
# an account-wide default CSP (default-src 'self'; script-src 'self'; no
# frame-src) — confirmed via `curl -I` on both domains: identical CSP string,
# same origin IP. That default silently blocked the Instagram embed script
# AND the Google Maps iframe on this site (both are third-party origins with
# no exception in the account default). Same failure class documented in
# SPEC.md §0.1 from a sibling ATL project — invisible from the page's own
# source, only shows up as "nothing loads" in the browser.
#
# Fix: declare our own CSP below with the specific exceptions this page
# needs. A per-site `Header always set` for the same header name overrides
# the account-wide default on this host — confirmed by X-Frame-Options
# already differing between axiel.co.za (DENY) and this site (SAMEORIGIN).
# If Instagram/Maps still don't load after this deploys, the override isn't
# taking effect here the way it does for X-Frame-Options — stop and check
# with a live `curl -I` before assuming the CSP values themselves are wrong.

Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.instagram.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.cdninstagram.com https://*.fbcdn.net https://*.google.com https://*.gstatic.com; frame-src 'self' https://www.instagram.com https://www.google.com https://maps.google.com; connect-src 'self' https://www.instagram.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

  # Host runs LiteSpeed with its own server-side page cache (LSCache),
  # invisible from this file — confirmed live on 2026-08-25: identical
  # requests (same URL, same user-agent) returned different HTML on
  # different hits, one of them a stale copy of an old A/B/C concept
  # switcher that predates this rebuild entirely. Force the HTML shell to
  # revalidate on every request so a deploy is never masked by a stale
  # cached page again. Static assets (images/CSS/JS) are untouched by
  # this and keep caching normally.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "\.(?:png|jpe?g|gif|webp|avif|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:css|js|webmanifest)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/)\.(?!well-known/)" - [F]
  RewriteCond %{HTTP_HOST} ^www\.pacificbusinesspark\.co\.za$ [NC]
  RewriteRule ^ https://pacificbusinesspark.co.za%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<FilesMatch "\.(bak|old|orig|md|log|sql|ini)$">
  Require all denied
</FilesMatch>
